set(CMAKE_BUILD_TYPE Release)
set(CMAKE_SYSTEM_NAME "@CMAKE_HOST_SYSTEM_NAME@" CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS "-O2")
set(CMAKE_CXX_FLAGS "-O2")
if ("@CMAKE_HOST_SYSTEM_NAME@" STREQUAL "Darwin" AND NOT "@_openflow_host_processor@" STREQUAL "")
    set(CMAKE_OSX_ARCHITECTURES "@_openflow_host_processor@" CACHE STRING "" FORCE)
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
set(CMAKE_C_COMPILER "@_openflow_host_c_compiler@" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "@_openflow_host_cxx_compiler@" CACHE FILEPATH "" FORCE)
set(CMAKE_MAKE_PROGRAM "@CMAKE_MAKE_PROGRAM@" CACHE FILEPATH "" FORCE)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "@CMAKE_BINARY_DIR@/openflow-host-bin")
